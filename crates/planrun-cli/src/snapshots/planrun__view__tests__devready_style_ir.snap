            replace-exact:
              path: README.md
              before: "cargo test\n```\n"
              after: "cargo test\npwsh -NoProfile -File tools/greet.ps1 -Names Ada,Linus\n```\n"
      - step: Verify
        at: L98
        actions:
          - at: L98
            by: fallback
            note:
              text: "**Verify:**"
          - at: L99
            by: "script#devready"
            run:
